# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings → Data API → Project URL and anon/public key.
# EXPO_PUBLIC_* variables are inlined into the app bundle, so only ever put the
# anon key here — never the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
