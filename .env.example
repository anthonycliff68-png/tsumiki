# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API Keys (or the Connect button at the top of the project).
#
# Use the PUBLISHABLE key (sb_publishable_...). It is meant to ship inside the
# app; Row Level Security is what actually protects the data. Never put the
# secret key (sb_secret_...) here - EXPO_PUBLIC_* values are baked into the
# bundle that goes on people's phones.
#
# Older projects show a legacy "anon" key instead, a long string starting eyJ.
# That still works: set EXPO_PUBLIC_SUPABASE_ANON_KEY to it instead.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
