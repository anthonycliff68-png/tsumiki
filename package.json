{
  "name": "tsumiki",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.10.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "go": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "tunnel": "expo start --go --tunnel",
    "build:dev": "eas build --profile development --platform ios",
    "test": "node --test --experimental-strip-types \"supabase/functions/_shared/*.test.ts\" \"src/lib/*.test.ts\"",
    "sim": "xcrun simctl boot Tsumiki 2>/dev/null; open -a Simulator; xcrun simctl openurl Tsumiki exp://127.0.0.1:8081",
    "reports": "node scripts/reports.mjs"
  },
  "private": true
}
